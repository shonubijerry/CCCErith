{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cccerith",
  // Custom entry = the Next.js/Payload app + the nightly backup job (see custom-worker.ts)
  "main": "custom-worker.ts",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "D1",
      // Created with `wrangler d1 create cccerith --location weur`
      "database_id": "dacada53-fc03-4302-aaef-2af959d2d8a8",
      "database_name": "cccerith",
      "remote": true,
    },
  ],
  "r2_buckets": [
    // Uploaded images
    { "binding": "R2", "bucket_name": "cccerith-media", "remote": true },
    // Backups (latest 2 restore points)
    { "binding": "BACKUPS", "bucket_name": "cccerith-backups", "remote": true },
  ],
  // Cloudflare Email Service: contact form + password reset emails
  "send_email": [{ "name": "EMAIL" }],
  "account_id": "e5d5d460d5114f727f30dc01a4b9e363",
  "vars": {
    // Switch to https://cccerithparish.co.uk when the domain moves to Cloudflare.
    "NEXT_PUBLIC_SERVER_URL": "https://cccerith.koredujar.workers.dev",
    "CF_ACCOUNT_ID": "e5d5d460d5114f727f30dc01a4b9e363",
    "D1_DATABASE_ID": "dacada53-fc03-4302-aaef-2af959d2d8a8",
  },
  // Nightly at 02:00 UTC: copy new images; on Sundays also make a full restore point.
  "triggers": { "crons": ["0 2 * * *"] },
  // Secrets (set with `wrangler secret put`): PAYLOAD_SECRET, CF_API_TOKEN, TURNSTILE_SECRET_KEY
}
